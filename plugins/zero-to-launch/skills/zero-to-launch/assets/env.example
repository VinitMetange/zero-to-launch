# Copy to .env.local for local development and fill in values.
# Never commit .env.local. Remove sections for services you did not choose.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: never put secrets in them.
# scripts/check-env.mjs treats every uncommented line as required. Later-phase variables
# start commented out; uncomment them when that phase begins.

# --- App (Phase 5) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: database, auth, storage (Phase 5) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI providers (Phase 5, keep whichever you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Transactional email: Resend (key in Phase 5, sender in Phase 7) ---
RESEND_API_KEY=
# EMAIL_FROM=

# --- Payments: Stripe (Phase 9) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Payments: Razorpay (Phase 9) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Analytics: PostHog (Phase 10) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# --- Error tracking: Sentry (Phase 10) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Rate limiting: Upstash (Phase 11) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Background service: Railway, if used (Phase 5) ---
# WORKER_URL=
# WORKER_SHARED_SECRET=
